PORT=5000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/antigravity
DIRECT_URL=postgresql://user:password@localhost:5432/antigravity

# Authentication
# Both secrets: at least 32 characters and different from each other (the server refuses to start otherwise)
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=your_super_secret_refresh_key
REFRESH_TOKEN_EXPIRES_IN=7d
# Generate long random secrets, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# Admin account (required — admin login is disabled when these are missing)
ADMIN_EMAIL=you@example.com
# bcrypt hash of your password:  npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH=
# Optional TOTP 2FA. Log in once, open GET /api/auth/setup-2fa, scan the QR, put the secret here.
ADMIN_2FA_SECRET=

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Client
CLIENT_URL=http://localhost:5173

# Telegram notifications for contact form messages (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Salt for hashing visitor IPs in analytics (any long random string; keep it stable)
IP_HASH_SALT=

# Reverse proxies in front of the API (Render = 1; add one per extra proxy such as Cloudflare)
TRUST_PROXY=1
# Days to keep analytics visit rows (0 = keep forever)
VISIT_RETENTION_DAYS=365
